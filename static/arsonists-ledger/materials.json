[{"id":"gasoline","name":"Gasoline","kind":"fuel","category":"liquid","isTool":false,"defaultPrice":495,"tornId":172,"intensity":1.5,"momentum":6,"suspicion":9,"ignitionRisk":1,"stokingRisk":7,"advice":"Cheap but risky when stoking. High suspicion and high stoking risk."},{"id":"diesel","name":"Diesel","kind":"fuel","category":"liquid","isTool":false,"defaultPrice":4972,"tornId":1458,"intensity":2,"momentum":5,"suspicion":7,"ignitionRisk":0,"stokingRisk":1,"advice":"Lowers crit-rate on ignition, increases visibility. Best combined with solids."},{"id":"kerosene","name":"Kerosene","kind":"fuel","category":"liquid","isTool":false,"defaultPrice":20874,"tornId":1457,"intensity":2,"momentum":10,"suspicion":3,"ignitionRisk":1,"stokingRisk":3,"advice":"Great as starter, insurance jobs, and small fires. Increases momentum in single area."},{"id":"magnesium","name":"Magnesium Shavings","kind":"fuel","category":"solid","isTool":false,"defaultPrice":64323,"tornId":1462,"intensity":8,"momentum":6,"suspicion":10,"ignitionRisk":3,"stokingRisk":4,"advice":"Best as starter, useful when low rurality. Halves dampening effectiveness and intensity decay from firefighters. Increases visibility."},{"id":"thermite","name":"Thermite","kind":"fuel","category":"solid","isTool":false,"defaultPrice":103992,"tornId":1461,"intensity":7,"momentum":4,"suspicion":7,"ignitionRisk":3,"stokingRisk":7,"advice":"Best as starter for total destruction. Multiplies damage rate for each use."},{"id":"potassium_nitrate","name":"Potassium Nitrate","kind":"fuel","category":"solid","isTool":false,"defaultPrice":52647,"tornId":1264,"intensity":10,"momentum":6,"suspicion":3,"ignitionRisk":3,"stokingRisk":1,"advice":"Best for stoking, excellent for <3 zone targets. Increases intensity by 25% of current intensity in single area."},{"id":"oxygen","name":"Oxygen Tank","kind":"fuel","category":"gaseous","isTool":false,"defaultPrice":29374,"tornId":1219,"intensity":6,"momentum":2,"suspicion":1,"ignitionRisk":2,"stokingRisk":1,"advice":"Terrible starter, excellent for stoking 4-5 zone targets. Increases intensity by 25% of current in all areas."},{"id":"methane","name":"Methane Tank","kind":"fuel","category":"gaseous","isTool":false,"defaultPrice":21308,"tornId":1460,"intensity":4,"momentum":1,"suspicion":-3,"ignitionRisk":2,"stokingRisk":3,"advice":"Excellent spread for large targets. Lowers accumulated suspicion."},{"id":"hydrogen","name":"Hydrogen Tank","kind":"fuel","category":"gaseous","isTool":false,"defaultPrice":20950,"tornId":1459,"intensity":4,"momentum":1,"suspicion":1,"ignitionRisk":2,"stokingRisk":3,"advice":"Best used for 3-5 zone targets, and when paired with one solid & one liquid. Averages intensity and momentum across all areas."},{"id":"lighter","name":"Windproof Lighter","kind":"tool","category":"igniter","isTool":true,"defaultPrice":2650,"tornId":544,"suspicion":1,"advice":"Great for fine-tuning and low suspicion jobs. Provides very small increase in intensity (+2.5%) and momentum. Crit rate depends on accelerants used."},{"id":"molotov","name":"Molotov Cocktail","kind":"tool","category":"igniter","isTool":false,"defaultPrice":77768,"tornId":742,"suspicion":6,"advice":"Great for spreading fires. Moderately high intensity (+17.5%) and momentum to area with lowest intensity based on the main zone momentum. Fixed crit rate."},{"id":"flamethrower","name":"Flamethrower","kind":"tool","category":"igniter","isTool":true,"defaultPrice":2543736,"tornId":255,"suspicion":8,"advice":"High intensity/momentum randomly across areas with high visibility."},{"id":"blanket","name":"Blanket","kind":"tool","category":"dampener","isTool":true,"defaultPrice":6776,"tornId":1235,"advice":"Lowers intensity and momentum by ~25%. Has high crit rate (~20% with low skill). May be lost on fail."},{"id":"sand","name":"Sand","kind":"tool","category":"dampener","isTool":false,"defaultPrice":25189,"tornId":833,"advice":"Twice as effective and half as risky as a Blanket. Effective for controlled burns. Is consumed on use."},{"id":"fire_extinguisher","name":"Fire Extinguisher","kind":"tool","category":"dampener","isTool":false,"defaultPrice":92129,"tornId":1463,"advice":"As effective as Sand, but safer to use. Is consumed on use."},{"id":"ammonia","name":"Ammonia","kind":"evidence","category":"misc","isTool":false,"defaultPrice":2416,"tornId":1248},{"id":"cannabis","name":"Cannabis","kind":"evidence","category":"misc","isTool":false,"defaultPrice":6120,"tornId":196},{"id":"compass","name":"Compass","kind":"evidence","category":"misc","isTool":false,"defaultPrice":14140,"tornId":407},{"id":"diamond_ring","name":"Diamond Ring","kind":"evidence","category":"misc","isTool":false,"defaultPrice":2648,"tornId":54},{"id":"elephant_statue","name":"Elephant Statue","kind":"evidence","category":"misc","isTool":false,"defaultPrice":3881,"tornId":280},{"id":"family_photo","name":"Family Photo","kind":"evidence","category":"misc","isTool":false,"defaultPrice":594,"tornId":1089},{"id":"glitter_bomb","name":"Glitter Bomb","kind":"evidence","category":"misc","isTool":false,"defaultPrice":384907,"tornId":1294},{"id":"gold_tooth","name":"Gold Tooth","kind":"evidence","category":"misc","isTool":false,"defaultPrice":13853,"tornId":1282},{"id":"grenade","name":"Grenade","kind":"evidence","category":"misc","isTool":false,"defaultPrice":6964,"tornId":220},{"id":"hard_drive","name":"Hard Drive","kind":"evidence","category":"misc","isTool":false,"defaultPrice":303,"tornId":45},{"id":"jade_buddha","name":"Jade Buddha","kind":"evidence","category":"misc","isTool":false,"defaultPrice":11038,"tornId":275},{"id":"kabuki_mask","name":"Kabuki Mask","kind":"evidence","category":"misc","isTool":false,"defaultPrice":29182,"tornId":278},{"id":"lipstick","name":"Lipstick","kind":"evidence","category":"misc","isTool":false,"defaultPrice":205,"tornId":1085},{"id":"mayan_statue","name":"Mayan Statue","kind":"evidence","category":"misc","isTool":false,"defaultPrice":2771,"tornId":259},{"id":"opium"